<%- include('./partials/_header') %>

<div class="main-hero">
    <h1 class="hero-title">Academia Avanza</h1>
    <p class="hero-sub">Panel de administración</p>
</div>

<div class="cards-grid">

    <a href="/alumnos" class="card card--alumnos">
        <div class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
        </div>
        <div class="card-body">
            <h2 class="card-title">Alumnos</h2>
            <p class="card-desc">Gestiona el registro, edición y baja de estudiantes.</p>
        </div>
        <span class="card-arrow">→</span>
    </a>

    <a href="/matricula" class="card card--matricula">
        <div class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
                <line x1="8" y1="14" x2="16" y2="14"/>
            </svg>
        </div>
        <div class="card-body">
            <h2 class="card-title">Matrículas</h2>
            <p class="card-desc">Administra las inscripciones de alumnos a cursos y aulas.</p>
        </div>
        <span class="card-arrow">→</span>
    </a>

    <a href="/curso" class="card card--curso">
        <div class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
        </div>
        <div class="card-body">
            <h2 class="card-title">Cursos</h2>
            <p class="card-desc">Consulta y actualiza los cursos disponibles por carrera.</p>
        </div>
        <span class="card-arrow">→</span>
    </a>

    <a href="/aula" class="card card--aula">
        <div class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
        </div>
        <div class="card-body">
            <h2 class="card-title">Aulas</h2>
            <p class="card-desc">Administra las aulas y su capacidad por edificio.</p>
        </div>
        <span class="card-arrow">→</span>
    </a>

</div>

